{
    "name": "affordablemobiles/eloquent-datastore",
    "description": "A package for using Google Datastore as a database driver.",
    "type": "package",
    "license": "MIT",
    "keywords": ["laravel datastore", "eloquent datastore", "datastore", "google datastore"],
    "authors": [
        {
            "name": "Samuel Melrose",
            "email": "sam.melrose@affordablemobilels.co.uk"
        },
        {
            "name": "Appsero",
            "email": "help@appsero.com"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "ext-json": "*",
        "illuminate/support": "^13.0",
        "illuminate/pagination": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "google/cloud-datastore": "^1.32.3",
        "affordablemobiles/laravel-eloquent-query-cache": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.35|^11.5.3|^12.0.1",
        "friendsofphp/php-cs-fixer": "^3.77",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AffordableMobiles\\EloquentDatastore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AffordableMobiles\\EloquentDatastore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AffordableMobiles\\EloquentDatastore\\DatastoreServiceProvider"
            ]
        }
    },
    "scripts": {
        "cs-fix": [
            "@php -n ./vendor/bin/php-cs-fixer fix --config=./.php-cs-fixer.php"
        ],
        "cs-audit": [
            "@php -n ./vendor/bin/php-cs-fixer fix --config=./.php-cs-fixer.php --dry-run"
        ],
        "test": [
            "@php -n ./vendor/bin/phpunit"
        ]
    }
}
